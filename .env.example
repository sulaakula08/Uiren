# Скопируйте этот файл в .env и заполните значения.
#
# ВАЖНО: именно в .env, а не в .env.local.
# Next.js читает оба файла, но Prisma CLI (migrate, generate, seed) читает
# только .env. Если строки подключения положить в .env.local, приложение
# запустится, а миграции упадут с «Environment variable not found».

# ── База данных: Supabase (PostgreSQL) ───────────────────────────────────────
# Пароль базы берётся в Supabase: Project Settings → Database.
# Спецсимволы в пароле нужно URL-кодировать: @ → %40, # → %23, / → %2F.

# Приложение ходит через transaction-пул (порт 6543).
# pgbouncer=true обязателен: без него Prisma использует prepared statements,
# которых пул в этом режиме не поддерживает, и запросы начнут падать
# с «prepared statement "s0" already exists».
# connection_limit=1 не подходит: страницы делают по 4–5 запросов через
# Promise.all, и с пулом в одно соединение они выстраиваются в очередь и
# отваливаются по таймауту. 5 хватает, pool_timeout=20 даёт запас на задержку
# до Сингапура.
DATABASE_URL="postgresql://postgres.hndzdxjznylzivkvodhk:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"

# Миграции идут напрямую, через session-пул (порт 5432): DDL и advisory-локи
# через transaction-пул не проходят.
DIRECT_URL="postgresql://postgres.hndzdxjznylzivkvodhk:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── Сессии ──────────────────────────────────────────────────────────────────
# Секрет для подписи сессионных cookie. Сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Вход через Google ───────────────────────────────────────────────────────
# OAuth 2.0 Client ID из Google Cloud Console (тип Web application).
# В Authorized JavaScript origins добавьте http://localhost:3000 и адрес прода.
# Client Secret здесь не нужен: проверяется только ID-токен на сервере.
# Пусто — кнопка входа через Google просто не появится, остальное живёт.
#
# Значение одно и то же в двух переменных, и это не дубль: GOOGLE_CLIENT_ID
# читает сервер при проверке токена, NEXT_PUBLIC_… уезжает в браузер, где
# кнопка Google должна знать, от чьего имени просить вход. Client ID публичен
# по своей природе — он виден в исходниках страницы. Client Secret не нужен.
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ── Только для разработки ───────────────────────────────────────────────────
# Разрешает входу через Google заводить аккаунт без кода школы: удобно, пока
# идёт разработка, и незачем каждый раз проходить регистрацию.
#
# Действует только когда сборка НЕ продакшен. На Vercel флаг не сработает,
# даже если его туда прописать: иначе один забытый переключатель открыл бы
# вход в платформу с работами и оценками школьников любому человеку с Gmail.
UIREN_UNSAFE_OPEN_SIGNUP=""
# Код школы, в которую зачислять таких пользователей. По умолчанию DEMO25.
UIREN_DEV_SCHOOL_CODE=""

# ── AI ──────────────────────────────────────────────────────────────────────
# Ключ Claude API. Получить: https://console.anthropic.com/settings/keys
# Без него AI-функции вернут понятную ошибку, остальная платформа работает.
ANTHROPIC_API_KEY=""

# Модели: opus — аналитика и прогнозы, sonnet — массовая проверка и генерация.
UIREN_MODEL_HEAVY="claude-opus-5"
UIREN_MODEL_FAST="claude-sonnet-5"
