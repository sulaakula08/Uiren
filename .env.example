# Скопируйте этот файл в .env и заполните значения.
#
# ВАЖНО: именно в .env, а не в .env.local.
# Next.js читает оба файла, но Prisma CLI (migrate, generate, seed) читает
# только .env. Если строки подключения положить в .env.local, приложение
# запустится, а миграции упадут с «Environment variable not found».

# ── База данных: Supabase (PostgreSQL) ───────────────────────────────────────
# Пароль базы берётся в Supabase: Project Settings → Database.
# Спецсимволы в пароле нужно URL-кодировать: @ → %40, # → %23, / → %2F.

# Приложение ходит через transaction-пул (порт 6543).
# pgbouncer=true обязателен: без него Prisma использует prepared statements,
# которых пул в этом режиме не поддерживает, и запросы начнут падать
# с «prepared statement "s0" already exists».
DATABASE_URL="postgresql://postgres.hndzdxjznylzivkvodhk:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Миграции идут напрямую, через session-пул (порт 5432): DDL и advisory-локи
# через transaction-пул не проходят.
DIRECT_URL="postgresql://postgres.hndzdxjznylzivkvodhk:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── Сессии ──────────────────────────────────────────────────────────────────
# Секрет для подписи сессионных cookie. Сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Вход через Google ───────────────────────────────────────────────────────
# OAuth 2.0 Client ID из Google Cloud Console (тип Web application).
# В Authorized JavaScript origins добавьте http://localhost:3000 и адрес прода.
# Client Secret здесь не нужен: проверяется только ID-токен на сервере.
# Пусто — кнопка входа через Google просто не работает, остальное живёт.
GOOGLE_CLIENT_ID=""

# ── AI ──────────────────────────────────────────────────────────────────────
# Ключ Claude API. Получить: https://console.anthropic.com/settings/keys
# Без него AI-функции вернут понятную ошибку, остальная платформа работает.
ANTHROPIC_API_KEY=""

# Модели: opus — аналитика и прогнозы, sonnet — массовая проверка и генерация.
UIREN_MODEL_HEAVY="claude-opus-5"
UIREN_MODEL_FAST="claude-sonnet-5"
