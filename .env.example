# Скопируйте этот файл в .env и заполните значения.

# База данных (SQLite локально; для продакшена — Postgres на серверах в РК)
DATABASE_URL="file:./dev.db"

# Секрет для подписи сессионных cookie. Сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Ключ Claude API. Получить: https://console.anthropic.com/settings/keys
# Без него AI-функции вернут понятную ошибку, остальная платформа работает.
ANTHROPIC_API_KEY=""

# Модели: opus — аналитика и прогнозы, sonnet — массовая проверка и генерация.
UIREN_MODEL_HEAVY="claude-opus-5"
UIREN_MODEL_FAST="claude-sonnet-5"
